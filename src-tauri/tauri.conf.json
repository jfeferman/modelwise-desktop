{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modelwise",
  "version": "0.1.0",
  "identifier": "com.modelwise.desktop",
  "build": {
    "beforeDevCommand": "npm run cli && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/modelwise"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
